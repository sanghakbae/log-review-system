# Firebase web app config — copy from Firebase console → Project settings → Web app
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Cloudflare R2 Worker base URL (file storage)
VITE_R2_WORKER_URL=https://lrs-r2-files.your-subdomain.workers.dev

# Email domain allowed to sign in (optional)
VITE_ALLOWED_DOMAIN=example.com

# OpenAI (used for AI review guide generation)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
